#!/bin/sh
# Kontrola formátu commit zprávy podle AGENTS.md.
first_line=$(head -n 1 "$1")

# Automatické zprávy Gitu necháváme být.
case "$first_line" in
	"Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|level|art|audio|ui|refactor|docs|chore): [^ ].*[^.]$'; then
	echo "Commit zpráva nemá správný formát: <typ>: <krátký popis>" >&2
	echo "Typy: feat, fix, level, art, audio, ui, refactor, docs, chore" >&2
	echo "Příklad: feat: přidá dvojskok   (podrobnosti v AGENTS.md)" >&2
	exit 1
fi

if [ "$(printf '%s' "$first_line" | wc -m)" -gt 72 ]; then
	echo "První řádek commit zprávy má víc než 72 znaků." >&2
	exit 1
fi
